(let ((proj-root "/home/joe/emacs/maplev")
      (maple-root "/opt/maple2022"))
  (maplev-config
   :mapledir maple-root
   :bindir (concat maple-root "/bin.X86_64_LINUX")
   :maple-options "-B -A2 -e2"
   :maple (concat maple-root "/bin/maple")
   :include-path (concat proj-root "/maple")
   :pmaple "/home/joe/maple/toolbox/maplev/bin.X86_64_LINUX/pmaple"
   :project-source (concat proj-root "/maple/src/maplev.mpl")
   :compile (format "make -C %s mla-install" proj-root)))
